# Copy to .env and fill in required values before:
#   docker compose -f docker-compose.prod.yml up -d
# .env is gitignored. Empty values below fail Compose interpolation (?).

# Required. Generate with: openssl rand -base64 32
JWT_SECRET_KEY=

# Required. Same value for Postgres and the API connection string.
# Existing volumes keep the password they were initialized with (often postgres);
# set that value here. Rotation is ALTER USER in Postgres, then update this file.
# Do not use ';' — it splits the Npgsql connection string.
POSTGRES_PASSWORD=

# Optional. Free key from https://carto.com/basemaps/apikey (removes map watermark).
# CARTO_BASEMAPS_API_KEY=
